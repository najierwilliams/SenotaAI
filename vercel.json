{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "buildCommand": "pnpm build",
  "outputDirectory": "public",
  "functions": {
    "server.js": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    { "source": "/:path((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}
