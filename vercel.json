{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build",
  "outputDirectory": "public",
  "functions": {
    "api/[...path].js": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    { "source": "/:path((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}
